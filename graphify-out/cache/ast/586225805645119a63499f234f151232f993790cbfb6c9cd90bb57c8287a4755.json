mapper_src_schemas_admin_import_geocache_ts", "relation": "imports_from", "context": "import", "confidence": "EXTRACTED", "source_file": "/Users/florianbruniaux/Sites/perso/starmapper/src/app/api/admin/import-geocache/route.ts", "source_location": "L9", "weight": 1.0}, {"source": "users_florianbruniaux_sites_perso_starmapper_src_app_api_admin_import_geocache_route_ts", "target": "schemas_admin_import_geocache_adminimportgeocacheschema", "relation": "imports", "context": "import", "confidence": "EXTRACTED", "source_file": "/Users/florianbruniaux/Sites/perso/starmapper/src/app/api/admin/import-geocache/route.ts", "source_location": "L9", "weight": 1.0}, {"source": "users_florianbruniaux_sites_perso_starmapper_src_app_api_admin_import_geocache_route_ts", "target": "import_geocache_route_post", "relation": "contains", "confidence": "EXTRACTED", "source_file": "/Users/florianbruniaux/Sites/perso/starmapper/src/app/api/admin/import-geocache/route.ts", "source_location": "L11", "weight": 1.0}], "raw_calls": [{"caller_nid": "import_geocache_route_post", "callee": "json", "is_member_call": true, "source_file": "/Users/florianbruniaux/Sites/perso/starmapper/src/app/api/admin/import-geocache/route.ts", "source_location": "L14"}, {"caller_nid": "import_geocache_route_post", "callee": "requireAdminAuth", "is_member_call": false, "source_file": "/Users/florianbruniaux/Sites/perso/starmapper/src/app/api/admin/import-geocache/route.ts", "source_location": "L16"}, {"caller_nid": "import_geocache_route_post", "callee": "parseInt", "is_member_call": false, "source_file": "/Users/florianbruniaux/Sites/perso/starmapper/src/app/api/admin/import-geocache/route.ts", "source_location": "L19"}, {"caller_nid": "import_geocache_route_post", "callee": "get", "is_member_call": true, "source_file": "/Users/florianbruniaux/Sites/perso/starmapper/src/app/api/admin/import-geocache/route.ts", "source_location": "L19"}, {"caller_nid": "import_geocache_route_post", "callee": "jsonError", "is_member_call": false, "source_file": "/Users/florianbruniaux/Sites/perso/starmapper/src/app/api/admin/import-geocache/route.ts", "source_location": "L20"}, {"caller_nid": "import_geocache_route_post", "callee": "defineRoute(adminImportGeocacheSchema, async (_req, entries) => {\n    const rows = Object.entries(entries).map(([key, val]) => ({\n      key,\n      lat: val ? val[0] : null,\n      lng: val ? val[1] : null,\n    }));\n\n    let inserted = 0;\n    let skipped = 0;\n\n    // Batch upsert in chunks of 500\n    for (let i = 0; i < rows.length; i += 500) {\n      const batch = rows.slice(i, i + 500);\n      for (const row of batch) {\n        try {\n          await prisma.geoCache.upsert({\n            where: { key: row.key },\n            update: { lat: row.lat, lng: row.lng },\n            create: { key: row.key, lat: row.lat, lng: row.lng },\n          });\n          inserted++;\n        } catch {\n          skipped++;\n        }\n      }\n    }\n\n    const total = await prisma.geoCache.count();\n    return NextResponse.json({ inserted, skipped, total });\n  })", "is_member_call": false, "source_file": "/Users/florianbruniaux/Sites/perso/starmapper/src/app/api/admin/import-geocache/route.ts", "source_location": "L22"}, {"caller_nid": "import_geocache_route_post", "callee": "defineRoute", "is_member_call": false, "source_file": "/Users/florianbruniaux/Sites/perso/starmapper/src/app/api/admin/import-geocache/route.ts", "source_location": "L22"}]}