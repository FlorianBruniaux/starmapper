# == Database ================================================================
# Neon Postgres connection string (required)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# == GitHub ==================================================================
# Personal Access Token with read:user scope (required)
# Create at: https://github.com/settings/tokens -> Tokens (classic) -> read:user
GITHUB_TOKEN="ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# == Geocoding ===============================================================
# Jawg Places API -- primary geocoding provider (recommended)
JAWGMAP_ACCESS_TOKEN="your_jawg_token"

# Geoapify -- geocoding fallback #1 (recommended)
GEOAPIFY_APIKEY="your_geoapify_key"

# == Client-side (exposed to browser) =======================================
# Same token as JAWGMAP_ACCESS_TOKEN (NEXT_PUBLIC_ prefix required for browser)
NEXT_PUBLIC_JAWGMAP_ACCESS_TOKEN="your_jawg_token"

# App URL for metadata, OG tags, sitemap, Nominatim User-Agent
# Use http://localhost:3000 for local development
NEXT_PUBLIC_APP_URL="https://your-deployment-url.vercel.app"

# == Admin endpoints =========================================================
# Secret for /api/admin/* routes. If unset, all admin routes return 401.
# Generate: openssl rand -hex 32
ADMIN_SECRET="your_admin_secret"
