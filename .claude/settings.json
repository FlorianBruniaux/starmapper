{
  "permissions": {
    "allow": [
      "mcp__grepai__search",
      "mcp__grepai__trace_callers",
      "mcp__grepai__trace_callees",
      "mcp__grepai__trace_graph",
      "mcp__grepai__index_status",
      "mcp__perplexity__perplexity_search",
      "mcp__plugin_claude-mem_mcp-search__search",
      "Bash(pnpm vitest run:*)",
      "Bash(pnpm exec eslint:*)",
      "Bash(pnpm eslint:*)",
      "Bash(pnpm exec tsc:*)",
      "Bash(pnpm tsc --noEmit:*)",
      "Bash(rtk grep:*)",
      "Bash(rtk tsc:*)"
    ],
    "deny": [
      "Read(//**/.env*)",
      "Edit(//**/.env*)",
      "Write(//**/.env*)",
      "Bash(cat */**.env*:*)",
      "Bash(head */**.env*:*)",
      "Bash(tail */**.env*:*)",
      "Bash(grep */**.env*:*)",
      "Bash(cat *secret*:*)",
      "Bash(cat *token*:*)",
      "Read(//**/*.pem)",
      "Read(//**/*.key)",
      "Read(//**/*.cert)",
      "Edit(//**/*.pem)",
      "Edit(//**/*.key)",
      "Edit(//**/*.cert)",
      "Write(//**/*.pem)",
      "Write(//**/*.key)",
      "Write(//**/*.cert)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/dangerous-actions-blocker.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/security-gate.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": ".claude/hooks/config-protection.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/rtk-suggest.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": ".claude/hooks/test-gate-on-commit.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/auto-format.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": ".claude/hooks/typecheck-feedback.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": ".claude/hooks/ts-lint-feedback.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": ".claude/hooks/banner-reminder.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": ".claude/hooks/tdd-test-on-write.sh",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/post-release-doc-update.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/activity-logger.sh",
            "timeout": 3
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/notification.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/git-context.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": ".claude/hooks/smart-suggest.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/session-loader.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/session-reflector.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/pre-compact-snapshot.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
