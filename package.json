{
  "name": "starmapper",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:push": "sh -c 'set -a && . .env.local && set +a && prisma db push'",
    "db:generate": "prisma generate",
    "db:studio": "sh -c 'set -a && . .env.local && set +a && prisma studio'",
    "seed:geonames": "tsx scripts/seed-geocache-geonames.ts",
    "seed:geonames:dry": "tsx scripts/seed-geocache-geonames.ts --dry-run"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "@prisma/adapter-neon": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "maplibre-gl": "^5.21.0",
    "next": "16.2.0",
    "prisma": "^7.5.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
