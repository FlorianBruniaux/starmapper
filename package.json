{
  "name": "starmapper",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:push": "sh -c 'set -a && . .env.local && set +a && prisma db push'",
    "db:generate": "prisma generate",
    "db:studio": "sh -c 'set -a && . .env.local && set +a && prisma studio'",
    "seed:geonames": "tsx scripts/seed-geocache-geonames.ts",
    "seed:geonames:dry": "tsx scripts/seed-geocache-geonames.ts --dry-run",
    "batch:scan": "tsx scripts/batch-scan.ts",
    "batch:scan:dry": "tsx scripts/batch-scan.ts --dry-run",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "@prisma/adapter-neon": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "maplibre-gl": "^5.21.0",
    "next": "16.2.0",
    "prisma": "^7.5.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@prisma/adapter-pg": "^7.6.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitest/coverage-v8": "^4.1.2",
    "pg": "^8.20.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.2"
  }
}
