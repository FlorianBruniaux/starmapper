{
  "name": "starmapper",
  "version": "0.4.1",
  "private": true,
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "next dev",
    "dev:local": "sh -c 'set -a && . .env.local && set +a && DATABASE_DRIVER=standard DATABASE_URL=$DATABASE_URL_LOCAL next dev'",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --cache --cache-location .eslintcache",
    "lint:fix": "eslint . --fix",
    "db:setup": "sh -c 'set -a && . .env.local && set +a && bash scripts/db-setup.sh'",
    "db:push": "sh -c 'set -a && . .env.local && set +a && prisma db push'",
    "db:push:local": "sh -c 'set -a && . .env.local && set +a && DATABASE_DRIVER=standard DATABASE_URL=$DATABASE_URL_LOCAL prisma db push'",
    "db:generate": "prisma generate",
    "db:studio": "sh -c 'set -a && . .env.local && set +a && prisma studio'",
    "seed:geonames": "tsx scripts/seed-geocache-geonames.ts",
    "seed:geonames:dry": "tsx scripts/seed-geocache-geonames.ts --dry-run",
    "stats:views": "tsx scripts/view-stats.ts",
    "backfill:api-key-hash": "DATABASE_DRIVER=standard tsx scripts/backfill-api-key-hash.ts",
    "backfill:api-key-hash:prod": "DATABASE_DRIVER=standard DATABASE_URL=$DATABASE_URL tsx scripts/backfill-api-key-hash.ts",
    "backfill:organic-score": "sh -c 'set -a && . .env.local && set +a && DATABASE_DRIVER=standard DATABASE_URL=$DATABASE_URL_LOCAL tsx scripts/backfill-organic-score.ts \"$@\"' _",
    "backfill:organic-score:prod": "sh -c 'set -a && . .env.local && set +a && DATABASE_DRIVER=standard DATABASE_URL=$DATABASE_URL tsx scripts/backfill-organic-score.ts \"$@\"' _",
    "backfill:repo-metrics": "sh -c 'set -a && . .env.local && set +a && tsx scripts/backfill-repo-metrics.ts \"$@\"' _",
    "backfill:repo-metrics:prod": "sh -c 'set -a && . .env.local && set +a && DATABASE_URL_LOCAL= NEXT_PUBLIC_ORGANIC_SCORE_ENABLED=true tsx scripts/backfill-repo-metrics.ts \"$@\"' _",
    "backfill:repo-languages": "sh -c '[ \"$1\" = \"--\" ] && shift; tsx scripts/backfill-repo-languages.ts \"$@\"' _",
    "backfill:repo-languages:prod": "sh -c '[ \"$1\" = \"--\" ] && shift; tsx scripts/backfill-repo-languages.ts --prod \"$@\"' _",
    "backfill:languages": "sh -c '[ \"$1\" = \"--\" ] && shift; tsx scripts/backfill-languages.ts \"$@\"' _",
    "backfill:languages:prod": "sh -c '[ \"$1\" = \"--\" ] && shift; tsx scripts/backfill-languages.ts --prod \"$@\"' _",
    "backfill:linkedin": "sh -c '[ \"$1\" = \"--\" ] && shift; tsx scripts/backfill-linkedin.ts \"$@\"' _",
    "backfill:linkedin:prod": "sh -c '[ \"$1\" = \"--\" ] && shift; tsx scripts/backfill-linkedin.ts --prod \"$@\"' _",
    "backfill:user-top-repos": "sh -c '[ \"$1\" = \"--\" ] && shift; tsx scripts/backfill-user-top-repos.ts \"$@\"' _",
    "backfill:user-top-repos:prod": "sh -c '[ \"$1\" = \"--\" ] && shift; tsx scripts/backfill-user-top-repos.ts --prod \"$@\"' _",
    "backfill:locations": "tsx scripts/backfill-location-columns.ts",
    "batch:scan": "sh -c '[ \"$1\" = \"--\" ] && shift; tsx scripts/batch-scan.ts --local \"$@\"' _",
    "batch:scan:prod": "sh -c '[ \"$1\" = \"--\" ] && shift; tsx scripts/batch-scan.ts --allow-neon \"$@\"' _",
    "setup:mvs": "sh -c 'set -a && . .env.local && set +a && DATABASE_URL=$DATABASE_URL_LOCAL tsx scripts/setup-mvs.ts'",
    "setup:mvs:prod": "tsx scripts/setup-mvs.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "@prisma/adapter-neon": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "lucide-react": "^1.16.0",
    "maplibre-gl": "^5.22.0",
    "next": "16.2.6",
    "react": "19.2.5",
    "react-dom": "19.2.4",
    "swr": "^2.4.1",
    "topojson-client": "^3.1.0",
    "web-vitals": "^5",
    "world-atlas": "^2.0.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.2.3",
    "@prisma/adapter-pg": "^7.6.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^25",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^10.2.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "pg": "^8.20.0",
    "prisma": "^7.7.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "typescript-eslint": "^8.58.1",
    "vitest": "^4.1.2"
  }
}
