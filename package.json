{
  "name": "starmapper",
  "version": "0.2.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "next dev",
    "dev:local": "sh -c 'set -a && . .env.local && set +a && DATABASE_DRIVER=standard DATABASE_URL=$DATABASE_URL_LOCAL next dev'",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:push": "sh -c 'set -a && . .env.local && set +a && prisma db push'",
    "db:push:local": "sh -c 'set -a && . .env.local && set +a && DATABASE_URL=$DATABASE_URL_LOCAL prisma db push'",
    "db:generate": "prisma generate",
    "db:studio": "sh -c 'set -a && . .env.local && set +a && prisma studio'",
    "create:grid-mv": "tsx scripts/create-grid-mv.ts",
    "backfill:locations": "tsx scripts/backfill-location-columns.ts",
    "backfill:locations:local": "sh -c 'set -a && . .env.local && set +a && DATABASE_DRIVER=standard DATABASE_URL=$DATABASE_URL_LOCAL tsx scripts/backfill-location-columns.ts'",
    "backfill:linkedin": "tsx scripts/backfill-linkedin.ts",
    "backfill:linkedin:prod": "tsx scripts/backfill-linkedin.ts --prod",
    "backfill:linkedin:dry": "tsx scripts/backfill-linkedin.ts --dry-run",
    "backfill:repo-languages": "tsx scripts/backfill-repo-languages.ts",
    "backfill:repo-languages:prod": "tsx scripts/backfill-repo-languages.ts --prod",
    "backfill:repo-languages:dry": "tsx scripts/backfill-repo-languages.ts --dry-run",
    "backfill:languages": "tsx scripts/backfill-languages.ts",
    "backfill:languages:prod": "tsx scripts/backfill-languages.ts --prod",
    "backfill:languages:dry": "tsx scripts/backfill-languages.ts --dry-run",
    "fix:country-linkedin": "sh -c 'set -a && . .env.local && set +a && psql \"$DATABASE_URL\" -f scripts/fix-country-normalized-linkedin.sql'",
    "seed:geonames": "tsx scripts/seed-geocache-geonames.ts",
    "seed:geonames:dry": "tsx scripts/seed-geocache-geonames.ts --dry-run",
    "fix:slash-locations": "tsx scripts/fix-slash-locations.ts",
    "fix:slash-locations:dry": "tsx scripts/fix-slash-locations.ts --dry-run",
    "fix:bad-locations": "tsx scripts/fix-bad-locations.ts",
    "fix:bad-locations:dry": "tsx scripts/fix-bad-locations.ts --dry-run",
    "batch:scan": "tsx scripts/batch-scan.ts",
    "batch:scan:dry": "tsx scripts/batch-scan.ts --dry-run",
    "batch:scan:local": "caffeinate -i tsx scripts/batch-scan.ts --local",
    "batch:scan:local:dry": "tsx scripts/batch-scan.ts --local --dry-run",
    "collect:repos": "tsx scripts/collect-user-repos.ts",
    "collect:repos:dry": "tsx scripts/collect-user-repos.ts --dry-run",
    "collect:repos:t1": "tsx scripts/collect-user-repos.ts --token 1",
    "collect:repos:t2": "tsx scripts/collect-user-repos.ts --token 2",
    "collect:repos:t3": "tsx scripts/collect-user-repos.ts --token 3",
    "collect:repos:t4": "tsx scripts/collect-user-repos.ts --token 4",
    "collect:trending": "tsx scripts/collect-trending-repos.ts",
    "collect:trending:dry": "tsx scripts/collect-trending-repos.ts --dry-run",
    "collect:trending:t1": "tsx scripts/collect-trending-repos.ts --token 1",
    "collect:trending:t2": "tsx scripts/collect-trending-repos.ts --token 2",
    "collect:trending:t3": "tsx scripts/collect-trending-repos.ts --token 3",
    "collect:trending:t4": "tsx scripts/collect-trending-repos.ts --token 4",
    "collect:trending:systems": "tsx scripts/collect-trending-repos.ts --language rust --language go --language zig --language c --language cpp --output scripts/repos-systems.json",
    "collect:trending:jvm": "tsx scripts/collect-trending-repos.ts --language java --language kotlin --language scala --language clojure --language groovy --output scripts/repos-jvm.json",
    "collect:trending:scripting": "tsx scripts/collect-trending-repos.ts --language ruby --language elixir --language erlang --language haskell --language ocaml --language julia --output scripts/repos-scripting.json",
    "collect:merge": "node -e \"const fs=require('fs'),g=p=>fs.existsSync(p)?require(p):[];const a=g('./scripts/repos-from-users.json'),b=g('./scripts/repos-trending.json'),c=g('./scripts/repos-systems.json'),d=g('./scripts/repos-jvm.json'),e=g('./scripts/repos-scripting.json'),m=[...new Set([...a,...b,...c,...d,...e])];fs.writeFileSync('scripts/repos-all.json',JSON.stringify(m,null,2));console.log('Merged:',m.length,'repos')\"",
    "batch:scan:delta": "caffeinate -i tsx scripts/batch-scan.ts --local --input scripts/repos-all.json",
    "batch:scan:delta:dry": "tsx scripts/batch-scan.ts --local --input scripts/repos-all.json --dry-run",
    "stats:views": "tsx scripts/view-stats.ts",
    "db:sync": "sh -c 'set -a && . .env.local && set +a && ./scripts/db-sync-to-neon.sh \"$DATABASE_URL\"'",
    "db:sync:from-neon": "sh -c 'set -a && . .env.local && set +a && ./scripts/db-sync-from-neon.sh \"$DATABASE_URL\"'",
    "db:fix-countries": "sh -c 'set -a && . .env.local && set +a && psql \"$DATABASE_URL\" -f scripts/fix-country-normalization.sql'",
    "db:backfill-delta": "sh -c 'set -a && . .env.local && set +a && psql \"$DATABASE_URL\" -f scripts/backfill-latest-starred-at.sql'",
    "db:backfill-delta:local": "psql \"postgresql://starmapper:starmapper@localhost:5433/starmapper\" -f scripts/backfill-latest-starred-at.sql",
    "create:country-language-mv": "sh -c 'set -a && . .env.local && set +a && psql \"$DATABASE_URL_LOCAL\" -f scripts/create-country-language-mv.sql'",
    "create:country-language-mv:prod": "sh -c 'set -a && . .env.local && set +a && psql \"$DATABASE_URL\" -f scripts/create-country-language-mv.sql'",
    "create:user-repo-count-mv": "sh -c 'set -a && . .env.local && set +a && psql \"$DATABASE_URL_LOCAL\" -f scripts/create-user-repo-count-mv.sql'",
    "create:user-repo-count-mv:prod": "sh -c 'set -a && . .env.local && set +a && psql \"$DATABASE_URL\" -f scripts/create-user-repo-count-mv.sql'",
    "create:trgm-indexes": "sh -c 'set -a && . .env.local && set +a && psql \"$DATABASE_URL_LOCAL\" -f scripts/create-trgm-indexes.sql'",
    "create:trgm-indexes:prod": "sh -c 'set -a && . .env.local && set +a && psql \"$DATABASE_URL\" -f scripts/create-trgm-indexes.sql'",
    "refresh:country-language-mv": "sh -c 'set -a && . .env.local && set +a && psql \"$DATABASE_URL_LOCAL\" -c \"REFRESH MATERIALIZED VIEW country_language_stats_mv;\"'",
    "refresh:country-language-mv:prod": "sh -c 'set -a && . .env.local && set +a && psql \"$DATABASE_URL\" -c \"REFRESH MATERIALIZED VIEW country_language_stats_mv;\"'",
    "create:language-grid-mv": "sh -c 'set -a && . .env.local && set +a && psql \"$DATABASE_URL_LOCAL\" -f scripts/create-language-grid-mv.sql'",
    "create:language-grid-mv:prod": "sh -c 'set -a && . .env.local && set +a && psql \"$DATABASE_URL\" -f scripts/create-language-grid-mv.sql'",
    "refresh:language-grid-mv": "sh -c 'set -a && . .env.local && set +a && psql \"$DATABASE_URL_LOCAL\" -c \"REFRESH MATERIALIZED VIEW CONCURRENTLY language_grid_mv;\"'",
    "refresh:language-grid-mv:prod": "sh -c 'set -a && . .env.local && set +a && psql \"$DATABASE_URL\" -c \"REFRESH MATERIALIZED VIEW CONCURRENTLY language_grid_mv;\"'",
    "geo:key": "tsx scripts/generate-api-key.ts",
    "geo:test": "sh -c 'set -a && . .env.local && set +a && curl -s -H \"Authorization: Bearer $STARMAPPER_GEO_API_KEY\" http://localhost:3000/api/geo/facebook/react | python3 -m json.tool'",
    "geo:test:prod": "sh -c 'set -a && . .env.local && set +a && curl -s -H \"Authorization: Bearer $STARMAPPER_GEO_API_KEY\" https://starmapper.bruniaux.com/api/geo/facebook/react | python3 -m json.tool'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --cache --cache-location .eslintcache",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "@prisma/adapter-neon": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "maplibre-gl": "^5.22.0",
    "next": "16.2.3",
    "react": "19.2.5",
    "react-dom": "19.2.4",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "web-vitals": "^4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.2.4",
    "@prisma/adapter-pg": "^7.6.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^25",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^10.2.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "pg": "^8.20.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "prisma": "^7.7.0",
    "typescript-eslint": "^8.58.1",
    "vitest": "^4.1.2"
  }
}
