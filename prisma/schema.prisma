generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model GeoCache {
  key String @id
  lat Float?
  lng Float?

  @@map("geocache")
}

model BadgeCache {
  owner              String
  repo               String
  mappedCount        Int
  countryCount       Int
  totalCount         Int
  language           String?
  forksCount         Int?
  watchersCount      Int?
  organicScore       Int?
  organicTier        String?
  organicComputedAt  DateTime?
  openIssuesCount    Int?
  openPRsCount       Int?
  latestReleaseTag   String?
  latestReleaseUrl   String?
  latestReleaseAt    DateTime?
  releasesCount      Int?
  contributorsCount  Int?
  updatedAt          DateTime @updatedAt @default(now())

  @@id([owner, repo])
  @@index([updatedAt(sort: Desc)])
  @@map("badge_cache")
}

model StargazerCache {
  owner           String
  repo            String
  points          String
  unmapped        String
  totalCount      Int
  indexedBy       String?
  scannedAt       DateTime  @default(now())
  latestStarredAt DateTime?
  expiresAt       DateTime  @default(dbgenerated("NOW() + INTERVAL '90 days'"))

  @@id([owner, repo])
  @@index([expiresAt])
  @@map("stargazer_cache")
}

model FollowerCache {
  login      String   @id
  pointsGz   String   @db.Text
  unmappedGz String   @db.Text
  totalCount Int
  scannedAt  DateTime @default(now())
  expiresAt  DateTime @default(dbgenerated("NOW() + INTERVAL '90 days'"))

  @@index([expiresAt])
  @@map("follower_cache")
}

model DependentsCache {
  owner      String
  repo       String
  dataGz     String   @db.Text
  totalCount Int
  fetchedAt  DateTime @default(now())
  expiresAt  DateTime @default(dbgenerated("NOW() + INTERVAL '7 days'"))

  @@id([owner, repo])
  @@index([expiresAt])
  @@map("dependents_cache")
}

// Engaged-audience map (replaces the dead stargazer scan). Points are the
// deduplicated union of forkers, issue/PR authors, mentionables and watchers,
// geocoded, gzip+base64. Kept separate from stargazer_cache and star_event so
// engaged users never pollute the star-based MVs. See src/lib/engaged-audience.ts.
model EngagedCache {
  owner      String
  repo       String
  pointsGz   String   @db.Text
  unmappedGz String   @db.Text
  knownCount Int // distinct engaged users found (mapped + unmapped)
  starCount  Int // stargazerCount at fetch time, the coverage denominator
  channels   String // comma-separated channels used, e.g. "fork,issue,pr,mention,watch"
  scannedAt  DateTime @default(now())
  expiresAt  DateTime @default(dbgenerated("NOW() + INTERVAL '30 days'"))

  @@id([owner, repo])
  @@index([expiresAt])
  @@map("engaged_cache")
}

model GitHubUser {
  login            String      @id
  name             String?
  company          String?
  location         String?
  followers        Int         @default(0)
  following        Int         @default(0)
  publicRepos      Int         @default(0)
  accountCreatedAt DateTime?
  dataVersion      Int         @default(0)
  source           String      @default("stargazer")
  lat              Float?
  lng              Float?
  linkedinUrl          String?
  countryNormalized    String?
  cityNormalized       String?
  languages            String[]    @default([])
  languagesFetchedAt   DateTime?
  topRepos             Json?
  topReposFetchedAt    DateTime?
  fetchedAt            DateTime    @default(now())
  stars                StarEvent[]
  news                 News[]

  @@index([followers(sort: Desc)])
  @@index([company])
  @@index([location])
  @@index([lat, lng])
  @@index([countryNormalized])
  @@index([cityNormalized])
  @@index([languagesFetchedAt])
  @@index([fetchedAt])
  @@map("github_user")
}

model News {
  id          Int       @id @default(autoincrement())
  authorLogin String    @db.VarChar(39)
  body        String    @db.VarChar(280)
  url         String?   @db.VarChar(500)
  publishedAt DateTime  @default(now())
  deletedAt   DateTime?
  author      GitHubUser @relation(fields: [authorLogin], references: [login])

  @@index([authorLogin, publishedAt(sort: Desc)], name: "news_author_published_idx")
  @@index([publishedAt(sort: Desc)], name: "news_published_idx")
  @@map("news")
}

model StarEvent {
  id        Int        @id @default(autoincrement())
  login     String
  owner     String
  repo      String
  starredAt DateTime
  createdAt DateTime   @default(now())
  user      GitHubUser @relation(fields: [login], references: [login])

  @@unique([login, owner, repo])
  @@index([owner, repo, login])
  @@index([owner, repo, login, starredAt])
  @@index([login, starredAt(sort: Desc)])
  @@map("star_event")
}

// Curated seed of repos to keep fresh in Trending, independent of organic traffic.
// Seeded via scripts/db/seed-trending-watchlist.ts. Read by the refresh-trending cron.
model TrendingWatchlist {
  owner   String
  repo    String
  note    String?
  addedAt DateTime @default(now())

  @@id([owner, repo])
  @@map("trending_watchlist")
}

// Refresh ledger for the trending star-event rescan. One row per repo the cron has
// touched; lastRefreshedAt drives least-recently-refreshed rotation across runs.
model TrendingRefresh {
  owner           String
  repo            String
  lastRefreshedAt DateTime
  eventsAdded     Int      @default(0)

  @@id([owner, repo])
  @@index([lastRefreshedAt])
  @@map("trending_refresh")
}

model DeletionLog {
  id          Int       @id @default(autoincrement())
  login       String
  requestedAt DateTime  @default(now())
  deletedAt   DateTime?
  status      String    @default("pending")
  notes       String?

  @@index([login])
  @@index([requestedAt(sort: Desc)])
  @@map("deletion_log")
}

model PageView {
  type  String
  slug  String
  date  DateTime @db.Date
  count Int      @default(0)

  @@id([type, slug, date])
  @@index([slug])
  @@index([type, date])
  @@map("page_view")
}

model ApiKey {
  key        String    @id @default(uuid())
  keyHash    String?   @unique  // SHA-256(key) hex — run scripts/backfill-api-key-hash.ts to populate
  email      String
  name       String
  note       String?
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?
  lastUsedAt DateTime?

  @@map("api_key")
}

// Public roadmap vote (GitHub stargazer-restriction pivot). Upsert-by-ipHash: a repeat vote
// from the same hashed IP overwrites options rather than appending a row, which is both the
// "change your mind" UX and the anti-spam mechanism (see src/lib/ip-hash.ts).
model RoadmapVote {
  ipHash    String   @id
  options   String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roadmap_vote")
}
