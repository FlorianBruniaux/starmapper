generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model GeoCache {
  key String @id
  lat Float?
  lng Float?

  @@map("geocache")
}

model BadgeCache {
  owner        String
  repo         String
  mappedCount  Int
  countryCount Int
  totalCount   Int
  updatedAt    DateTime @updatedAt @default(now())

  @@id([owner, repo])
  @@index([updatedAt(sort: Desc)])
  @@map("badge_cache")
}

model StargazerCache {
  owner           String
  repo            String
  points          String
  unmapped        String
  totalCount      Int
  scannedAt       DateTime  @default(now())
  latestStarredAt DateTime?
  expiresAt       DateTime  @default(dbgenerated("NOW() + INTERVAL '90 days'"))

  @@id([owner, repo])
  @@index([expiresAt])
  @@map("stargazer_cache")
}

model GitHubUser {
  login            String      @id
  name             String?
  company          String?
  location         String?
  followers        Int         @default(0)
  following        Int         @default(0)
  publicRepos      Int         @default(0)
  accountCreatedAt DateTime?
  dataVersion      Int         @default(0)
  lat              Float?
  lng              Float?
  linkedinUrl          String?
  countryNormalized    String?
  cityNormalized       String?
  languages            String[]    @default([])
  languagesFetchedAt   DateTime?
  fetchedAt            DateTime    @default(now())
  stars                StarEvent[]

  @@index([followers(sort: Desc)])
  @@index([company])
  @@index([location])
  @@index([lat, lng])
  @@index([countryNormalized])
  @@index([cityNormalized])
  @@index([languagesFetchedAt])
  @@map("github_user")
}

model StarEvent {
  id        Int        @id @default(autoincrement())
  login     String
  owner     String
  repo      String
  starredAt DateTime
  createdAt DateTime   @default(now())
  user      GitHubUser @relation(fields: [login], references: [login])

  @@unique([login, owner, repo])
  @@index([login])
  @@index([owner, repo, login])
  @@map("star_event")
}

model DeletionLog {
  id          Int       @id @default(autoincrement())
  login       String
  requestedAt DateTime  @default(now())
  deletedAt   DateTime?
  status      String    @default("pending")
  notes       String?

  @@index([login])
  @@index([requestedAt(sort: Desc)])
  @@map("deletion_log")
}
