generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model GeoCache {
  key String @id
  lat Float?
  lng Float?

  @@map("geocache")
}

model BadgeCache {
  owner        String
  repo         String
  mappedCount  Int
  countryCount Int
  totalCount   Int
  updatedAt    DateTime @updatedAt @default(now())

  @@id([owner, repo])
  @@map("badge_cache")
}

model StargazerCache {
  owner      String
  repo       String
  points     Json
  unmapped   Json
  totalCount Int
  scannedAt  DateTime @default(now())
  expiresAt  DateTime @default(dbgenerated("NOW() + INTERVAL '90 days'"))

  @@id([owner, repo])
  @@map("stargazer_cache")
}

model GitHubUser {
  login            String      @id
  name             String?
  company          String?
  location         String?
  followers        Int         @default(0)
  following        Int         @default(0)
  publicRepos      Int         @default(0)
  accountCreatedAt DateTime?
  dataVersion      Int         @default(0)
  lat              Float?
  lng              Float?
  linkedinUrl      String?
  fetchedAt        DateTime    @default(now())
  stars            StarEvent[]

  @@index([followers(sort: Desc)])
  @@index([company])
  @@index([location])
  @@map("github_user")
}

model StarEvent {
  id        Int        @id @default(autoincrement())
  login     String
  owner     String
  repo      String
  starredAt DateTime
  createdAt DateTime   @default(now())
  user      GitHubUser @relation(fields: [login], references: [login])

  @@unique([login, owner, repo])
  @@index([owner, repo])
  @@index([login])
  @@map("star_event")
}
