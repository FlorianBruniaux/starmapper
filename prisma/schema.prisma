generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model GeoCache {
  key String @id
  lat Float?
  lng Float?

  @@map("geocache")
}

model BadgeCache {
  owner        String
  repo         String
  mappedCount  Int
  countryCount Int
  totalCount   Int
  updatedAt    DateTime @updatedAt @default(now())

  @@id([owner, repo])
  @@map("badge_cache")
}

model StargazerCache {
  owner      String
  repo       String
  points     Json
  unmapped   Json
  totalCount Int
  scannedAt  DateTime @default(now())

  @@id([owner, repo])
  @@map("stargazer_cache")
}
